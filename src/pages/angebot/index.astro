---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { pipe } from "remeda";

// HACK: Inlined svg assets are broken in inline css styles
import assetGrain from "src/assets/grain.svg?no-inline";
import { Cup } from "src/components/cup.tsx";
import Divider from "src/components/divider.astro";
import { dividerHeightPx } from "src/components/divider.ts";
import { H2, H3, H4 } from "src/components/heading.tsx";
import { Paper } from "src/components/paper.tsx";
import type { ColdDrink } from "src/content.config.ts";
import { colors, lineThicknessPx, on } from "src/css.ts";
import Layout from "src/layout.astro";
import { prng } from "src/prng.ts";

const coldDrinks = await getCollection("coldDrinks");

const coldDrinksByGroup: Map<string, ColdDrink[]> = new Map();
for (const coldDrink of coldDrinks) {
	for (const group of coldDrink.data.groups) {
		const drinks = coldDrinksByGroup.get(group);
		if (drinks) {
			drinks.push(coldDrink.data);
		} else {
			coldDrinksByGroup.set(group, [coldDrink.data]);
		}
	}
}

const hotDrinks = await getCollection("hotDrinks");

const random = prng(-1.5, 1.5, 0.75);
---

<Layout>
	<main>
		<section
			style={pipe(
				{
					"background-blend-mode": "overlay",
					"background-color": colors.creme,
					"background-image": `url(${assetGrain})`,
					"background-size": "256px",
					display: "grid",
					"grid-template-columns": "[main] minmax(0, 1fr) [main]",
					gap: "32px",
					"padding-inline": "32px",
					"padding-top": "32px",
					"padding-bottom": `${32 + dividerHeightPx}px`,
				},
				on("@media (min-width: 480px)", {
					"padding-inline": "64px",
					"padding-bottom": `${64 + dividerHeightPx}px`,
				}),
				on("@media (min-width: 768px)", {
					"grid-template-columns":
						"repeat(4, [main] minmax(0, 1fr)) [main]",
				}),
				on("@media (min-width: 1024px)", {
					gap: "32px",
					"align-items": "center",
					"grid-template-columns":
						"repeat(6, [main] minmax(0, 1fr)) [main]",
					"padding-top": "64px",
				}),
				on("@media (min-width: 1280px)", {
					"grid-template-columns": [
						"minmax(0, 1fr)",
						"repeat(6, [main] minmax(0, 1fr))",
						"[main] minmax(0, 1fr)",
					].join(" "),
					"padding-inline": 0,
				}),
			)}
		>
			<H2
				style={pipe(
					{
						"font-size": "64px",
						"grid-column-start": "main 1",
						"grid-column-end": "main -1",
						"justify-self": "start",
						// Half of the stroke width is covered by the fill color
						"-webkit-text-stroke-color": colors.espresso,
						"-webkit-text-stroke-width": "8px",
						"paint-order": "markers stroke fill",
						color: colors.milk,
						rotate: "1.5deg",
					},
					on("@media (min-width: 1024px)", {
						"font-size": "96px",
						"-webkit-text-stroke-width": "10px",
					}),
				)}
			>
				Heiß&shy;getränke
			</H2>
			<ul
				style={{
					display: "grid",
					"align-items": "center",
					"grid-template-columns": "subgrid",
					"grid-column-start": "main 1",
					"grid-column-end": "main -1",
					"row-gap": "32px",
				}}
			>
				{
					hotDrinks.map((hotDrink) => (
						<li
							style={pipe(
								{
									display: "grid",
									gap: "16px",
									"grid-template-columns": "minmax(0, 1fr)",
									"grid-template-rows":
										"max-content max-content",
									rotate: `${random()}deg`,
								},
								on("@media (min-width: 768px)", {
									"grid-column-end": "span 2",
								}),
							)}
						>
							<Paper
								style={{
									"grid-column-start": "1",
									"grid-column-end": "-1",
									"grid-row-start": "1",
									"grid-row-end": "-1",
								}}
							/>
							<div
								style={{
									"grid-column-start": "1",
									"grid-row-start": "1",
									"z-index": "1",
									padding: "16px",
									"border-bottom-style": "dotted",
									// Optically balance dotted line by increasing their size slightly
									"border-bottom-width": `${lineThicknessPx + 1}px`,
								}}
							>
								<H4>{hotDrink.data.name}</H4>
								<p>
									{new Intl.NumberFormat(undefined, {
										style: "currency",
										currency: "EUR",
									}).format(hotDrink.data.price)}
								</p>
							</div>
							<Cup
								ingredients={hotDrink.data.ingredients}
								style={pipe({
									"grid-column-start": "1",
									"grid-column-end": "-1",
									"grid-row-start": "-2",
									"grid-row-end": "-1",
									"margin-left": "-16px",
									"margin-bottom": "-8px",
									"z-index": "1",
								})}
							/>
						</li>
					))
				}
			</ul>
		</section>
		<Divider
			lineColor={colors.dark_teal}
			backgroundColor={colors.light_teal}
		/>
		<section
			style={pipe(
				{
					"background-color": colors.light_teal,
					color: colors.dark_teal,
					display: "grid",
					gap: "32px",
					"padding-inline": "32px",
					"padding-top": "32px",
					"padding-bottom": `${32 + dividerHeightPx}px`,
				},

				on("@media (min-width: 480px)", {
					"padding-inline": "64px",
					"padding-top": "64px",
					"padding-bottom": `${64 + dividerHeightPx}px`,
				}),
				on("@media (min-width: 768px)", {
					"grid-template-columns":
						"repeat(4, [main] minmax(0, 1fr)) [main]",
				}),
				on("@media (min-width: 1024px)", {
					"align-items": "center",
					"grid-template-columns":
						"repeat(6, [main] minmax(0, 1fr)) [main]",
				}),
				on("@media (min-width: 1280px)", {
					"grid-template-columns": [
						"minmax(0, 1fr)",
						"repeat(6, [main] minmax(0, 1fr))",
						"[main] minmax(0, 1fr)",
					].join(" "),
					"padding-inline": 0,
				}),
			)}
		>
			<H2
				style={pipe(
					{
						"font-size": "64px",
						"grid-column-start": "main 1",
						"grid-column-end": "main -1",
						"justify-self": "start",
						// Half of the stroke width is covered by the fill color
						"-webkit-text-stroke-color": colors.dark_teal,
						"-webkit-text-stroke-width": "8px",
						"paint-order": "markers stroke fill",
						color: colors.milk,
						rotate: "-1.5deg",
					},
					on("@media (min-width: 1024px)", {
						"font-size": "96px",
						"-webkit-text-stroke-width": "10px",
					}),
				)}
			>
				Kalt&shy;getränke
			</H2>
			{
				coldDrinksByGroup.entries().map(([group, drinks]) => (
					<>
						<H3
							style={pipe(
								{
									"grid-column-start": "main 1",
									"grid-column-end": "main -1",
									"font-size": "48px",
									"padding-left": `${32 + 12 + lineThicknessPx}px`,
									"padding-top": "32px",
								},
								on("@media (min-width: 1024px)", {
									"padding-left": `${32 + lineThicknessPx}px`,
								}),
							)}
						>
							{group}
						</H3>
						<ul
							style={pipe(
								{
									display: "grid",
									"grid-column-start": "main 1",
									"grid-column-end": "main -1",
									"grid-template-columns": "subgrid",
									"align-items": "center",
									"row-gap": "32px",
									"padding-left": "12px",
								},
								on("@media (min-width: 1024px)", {
									"row-gap": "32px",
									"padding-left": 0,
								}),
							)}
						>
							{drinks.map((drink) => (
								<Paper
									as="li"
									style={{
										"grid-column-end": "span 2",
										position: "relative",
										"padding-block": "16px",
										"padding-right": "16px",
										"padding-left": "32px",
										rotate: `${random()}deg`,
									}}
								>
									<H4 style={{}}>{drink.name}</H4>
									{drink.image && (
										<Image
											src={drink.image}
											alt={drink.name}
											style={{
												position: "absolute",
												left: 0,
												top: "-12px",
												bottom: "-12px",
												height: "calc(100% + 24px)",
												width: "auto",
												translate: "-50%",
											}}
										/>
									)}
									{/* TODO: Internationalization */}
									<p>
										{new Intl.NumberFormat(undefined, {
											style: "currency",
											currency: "EUR",
										}).format(drink.price)}
									</p>
									<p>{drink.size_litres}L</p>
								</Paper>
							))}
						</ul>
					</>
				))
			}
		</section>
	</main>
</Layout>
