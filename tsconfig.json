{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "astro/tsconfigs/strictest",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"types": ["node"],
		"paths": {
			"src/*": ["./src/*"]
		}
	}
}
