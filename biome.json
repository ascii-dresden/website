{
	"$schema": "https://biomejs.dev/schemas/2.3.9/schema.json",
	"root": true,
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"json": {
		"assist": {
			"enabled": false
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "es5"
		}
	},
	"linter": {
		"domains": {
			"solid": "recommended"
		},
		"rules": {
			"complexity": {
				"useArrowFunction": "off"
			}
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
