{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"root": true,
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							":NODE:",
							[":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", "!src/**"],
							":URL:",
							":BLANK_LINE:",
							"src/**",
							":BLANK_LINE:",
							":PATH:"
						]
					}
				}
			}
		}
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"json": {
		"assist": {
			"enabled": false
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "es5"
		}
	},
	"linter": {
		"includes": ["**", "!**/*.astro"],
		"domains": {
			"solid": "recommended"
		},
		"rules": {
			"complexity": {
				"useArrowFunction": "off"
			},
			"style": {
				"useImportType": "error"
			}
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
