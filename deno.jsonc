{
	"$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
	"tasks": {
		"build": "vike build",
		"dev": "vike dev",
		"preview": "vike preview",
		"check": "biome check",
		"fmt": "biome check --write"
	},
	"unstable": ["temporal"],
	"imports": {
		"@biomejs/biome": "npm:@biomejs/biome@^2.2.4",
		"@std/path": "jsr:@std/path@^1.1.2",
		"@valibot/valibot": "jsr:@valibot/valibot@^1.1.0",
		"@vanilla-extract/css": "npm:@vanilla-extract/css@^1.17.4",
		"@vanilla-extract/vite-plugin": "npm:@vanilla-extract/vite-plugin@^5.1.1",
		"solid-js": "npm:solid-js@^1.9.9",
		"src/": "./src/",
		"toml": "npm:toml@^3.0.0",
		"vike": "npm:vike@^0.4.240",
		"vike-solid": "npm:vike-solid@^0.7.13",
		"vite": "npm:vite@^7.1.5"
	},
	"nodeModulesDir": "auto",
	"compilerOptions": {
		"lib": ["deno.ns", "dom", "dom.iterable", "dom.asynciterable"],
		"jsx": "react-jsx",
		"jsxImportSource": "solid-js"
	}
}
