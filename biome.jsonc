{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"root": true,
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedKeys": "on",
			},
		},
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100,
	},
	"json": {
		"assist": {
			"enabled": false,
		},
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "es5",
		},
	},
	"linter": {
		"domains": {
			"solid": "recommended",
		},
		"rules": {
			"complexity": {
				"useArrowFunction": "off",
			},
		},
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true,
	},
}
